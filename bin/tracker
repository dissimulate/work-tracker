#!/bin/sh
# On the Bash tool's PATH while the plugin is enabled. Runs the scripts/tracker package.
scripts="$(dirname "$0")/../scripts"
. "$scripts/python.sh"
exec "$python" -I -X utf8 ${pycache:+-X} ${pycache:+"pycache_prefix=$pycache"} -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from tracker.cli import main; main()' \
  "$scripts" "$@"
